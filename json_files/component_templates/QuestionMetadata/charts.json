   "stacked_bar_chart": {
      "type": "stacked_bar_chart",
      "description": "Stacked bar chart showing multiple data series",
      "structure": {
         "title": "Chart Title",
         "x_axis": {
            "label": "Categories",
            "type": "categorical"
         },
         "y_axis": {
            "label": "Values",
            "type": "numerical"
         },
         "data_format": {
            "categories": ["Category 1", "Category 2", "Category 3"],
            "series": [
               {
                  "name": "Series 1",
                  "values": [20, 30, 25],
                  "color": "#3498db"
               },
               {
                  "name": "Series 2",
                  "values": [15, 20, 18],
                  "color": "#e74c3c"
               },
               {
                  "name": "Series 3",
                  "values": [10, 15, 12],
                  "color": "#2ecc71"
               }
            ]
         }
      }
   },
   "donut_chart": {
      "type": "donut_chart",
