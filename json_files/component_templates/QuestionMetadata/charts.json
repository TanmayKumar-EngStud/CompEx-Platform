{
   "line_chart": {
      "type": "line_chart",
      "description": "Line graph showing trends over time or continuous data",
      "structure": {
         "title": "Chart Title",
         "x_axis": {
            "label": "Time/Continuous Variable",
            "type": "continuous"
         },
         "y_axis": {
            "label": "Values",
            "type": "numerical"
         },
         "data_format": {
            "points": [
               { "x": 0, "y": 25 },
               { "x": 1, "y": 45 },
               { "x": 2, "y": 30 },
               { "x": 3, "y": 60 },
               { "x": 4, "y": 55 }
            ],
            "line_color": "#3498db",
            "point_color": "#2c3e50"
         }
      }
   },
   "bar_chart": {
      "type": "bar_chart",
      "description": "You need to create chart in this format, here you need to give description, this is an example format of bar_chart development",
      "structure": {
         "title": "Chart Title",
         "x_axis": {
            "label": "Categories",
            "type": "categorical"
         },
         "y_axis": {
            "label": "Values",
            "type": "numerical"
         },
         "data_format": {
            "categories": [
               "Category 1",
               "Category 2",
               "Category 3",
               "Category 4"
            ],
            "values": [25, 45, 30, 60],
            "colors": ["#3498db", "#e74c3c", "#2ecc71", "#f39c12"]
         }
      }
   },
   "pie_chart": {
      "type": "pie_chart",
      "description": "Circular pie chart showing proportional data sum of all the percentages should be equal to 100.",
      "structure": {
         "title": "Chart Title",
         "data_format": {
            "segments": [
               { "label": "Segment 1", "value": 30, "percentage": 25.0 },
               { "label": "Segment 2", "value": 45, "percentage": 37.5 },
               { "label": "Segment 3", "value": 25, "percentage": 20.8 },
               { "label": "Segment 4", "value": 20, "percentage": 16.7 }
            ],
            "colors": ["#3498db", "#e74c3c", "#2ecc71", "#f39c12"]
         }
      }
   },
   "scatter_chart": {
      "type": "scatter_chart",
