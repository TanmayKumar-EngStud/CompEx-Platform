{
   "line_chart": {
      "type": "line_chart",
      "description": "Line graph showing trends over time or continuous data. MUST have at least 7 data points.",
      "structure": {
         "title": "Monthly Revenue Growth",
         "x_axis": {
            "label": "Month",
            "type": "continuous"
         },
         "y_axis": {
            "label": "Revenue ($k)",
            "type": "numerical"
         },
         "data_format": {
            "points": [
               {
                  "x": "Jan",
                  "y": 25
               },
               {
                  "x": "Feb",
                  "y": 45
               },
               {
                  "x": "Mar",
                  "y": 30
               },
               {
                  "x": "Apr",
                  "y": 60
               },
               {
                  "x": "May",
                  "y": 55
               },
               {
                  "x": "Jun",
                  "y": 70
               },
               {
                  "x": "Jul",
                  "y": 65
               }
            ],
            "line_color": "#3498db",
            "point_color": "#2c3e50"
         }
      }
   },
   "bar_chart": {
      "type": "bar_chart",
      "description": "Bar chart comparing different categories. MUST have at least 7 categories.",
