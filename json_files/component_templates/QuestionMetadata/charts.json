            "segments": [
               { "label": "Segment 1", "value": 30, "percentage": 25.0 },
               { "label": "Segment 2", "value": 45, "percentage": 37.5 },
               { "label": "Segment 3", "value": 25, "percentage": 20.8 },
               { "label": "Segment 4", "value": 20, "percentage": 16.7 }
            ],
            "colors": ["#3498db", "#e74c3c", "#2ecc71", "#f39c12"],
