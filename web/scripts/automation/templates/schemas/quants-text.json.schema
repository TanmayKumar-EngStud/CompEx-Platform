{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "question_text": {
      "type": "string",
      "minLength": 10,
      "description": "The full text of the question stem including LaTeX formulas."
    }
  },
  "required": ["question_text"],
  "additionalProperties": false
}
