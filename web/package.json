{
  "name": "compex",
  "version": "1.1.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "./scripts/backup-db.sh && next dev",
    "backup": "./scripts/backup-db.sh",
    "build": "tsx scripts/automation/deploy-check.ts && node scripts/analysis/generate-build-info.js && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate && fumadocs-mdx",
    "version:update": "node -e \"const pkg = require('./package.json'); pkg.version = '1.1.' + Date.now(); require('fs').writeFileSync('./package.json', JSON.stringify(pkg, null, 2));\"",
    "seed": "ts-node prisma/seed.ts",
    "analyze": "ANALYZE=true next build",
    "analyze-bundle": "tsx scripts/analysis/analyze-bundle.ts",
    "analyze-deps": "node scripts/analysis/bundle-analyzer.js",
    "optimize-db": "tsx scripts/database/optimize-database.ts",
    "perf-report": "node scripts/analysis/bundle-analyzer.js && tsx scripts/analysis/analyze-bundle.ts && tsx scripts/database/optimize-database.ts",
    "evolve": "tsx scripts/automation/evolve.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@inquirer/prompts": "^8.2.0",
    "@prisma/client": "^5.17.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@reduxjs/toolkit": "^2.2.6",
    "@tanstack/react-query": "^5.81.5",
    "@types/d3": "^7.4.3",
    "@types/mdx": "^2.0.13",
    "@types/pg": "^8.11.6",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.71",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.17.0",
    "fumadocs-core": "14",
    "fumadocs-mdx": "11",
    "fumadocs-ui": "14",
    "input-otp": "^1.4.2",
    "jose": "^6.1.3",
    "katex": "^0.16.11",
    "lucide-react": "^0.484.0",
    "moment": "^2.30.1",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "pg": "^8.12.0",
    "prisma": "^5.17.0",
    "react": "^18",
    "react-dom": "^18",
    "react-easy-crop": "^5.5.6",
    "react-katex": "^3.0.1",
    "react-mathjax2": "^0.0.2",
    "react-redux": "^9.1.2",
    "recharts": "^2.15.1",
    "redis": "^4.7.0",
    "sharp": "^0.33.5",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.0.3",
    "zod": "^3.23.8",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.3",
    "@swc/helpers": "^0.5.17",
    "@types/bcryptjs": "^3.0.0",
    "@types/dotenv": "^8.2.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-katex": "^3.0.4",
    "autoprefixer": "10",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "pnpm": {
    "overrides": {
      "@next/swc-darwin-arm64": "15.5.12",
      "@next/swc-darwin-x64": "15.5.12",
      "@next/swc-linux-arm64-gnu": "15.5.12",
      "@next/swc-linux-arm64-musl": "15.5.12",
      "@next/swc-linux-x64-gnu": "15.5.12",
      "@next/swc-linux-x64-musl": "15.5.12",
      "@next/swc-win32-arm64-msvc": "15.5.12",
      "@next/swc-win32-x64-msvc": "15.5.12"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}