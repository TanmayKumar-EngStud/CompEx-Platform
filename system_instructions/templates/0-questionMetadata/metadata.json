  },
  "metadata": {
    "version": "1.0",
    "description": "Unified content metadata configuration for GMAT/GRE question generation system",
    "last_updated": "2025-07-07",
    "supported_content_types": ["graph", "passage", "table"],
    "supported_formats": ["json", "svg", "canvas"],
    "frontend_compatibility": ["react", "vue", "angular"],
    "class_structure": {
      "content": {
        "description": "Base content class",
        "child_classes": ["graph", "passage", "table"]
      },
      "graph": {
        "description": "Graph content class for charts and visualizations",
        "data_source": "content_types.graph.chart_styles"
      },
      "passage": {
        "description": "Passage content class for text-based content",
        "data_source": "content_types.passage.passage_styles"
      },
      "table": {
        "description": "Table content class for structured data",
        "data_source": "content_types.table.table_styles"
      }
    }
  }
}